# Copy to .env for local development. .env is gitignored.
# Works with any Postgres 12+: a local install, Docker, or Aurora.

# Local Postgres (or the Docker setup from docker-compose.yml)
DATABASE_URL=postgres://experience:experience@localhost:5433/experience_agent
DATABASE_SSL=off

# Aurora / RDS example: TLS on, verified against the RDS CA bundle.
# DATABASE_URL=postgres://<user>:<password>@<cluster>.<region>.rds.amazonaws.com:5432/experience_agent
# DATABASE_SSL=on
# DATABASE_SSL_CA_FILE=/path/to/global-bundle.pem

# Tests need an EXISTING database whose name contains "test".
# Create it yourself (the Docker setup creates it for you).
TEST_DATABASE_URL=postgres://experience:experience@localhost:5433/experience_agent_test

DS_PACK=vds
PORT=8787
# Picker list cache, in milliseconds
COMPOSITION_LIST_TTL_MS=30000

# Model. Point ANTHROPIC_BASE_URL at your org's gateway if you have one.
# Keep the real key in .env only; it is never logged.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
MODEL_ID=
MODEL_TIMEOUT_MS=60000

# Guidelines RAG app (POST {RAG_BASE_URL}/query). Leave RAG_BASE_URL empty to use the file stub.
RAG_BASE_URL=
RAG_API_KEY=
RAG_TIMEOUT_MS=10000

# Connections for active runs (one per thread running at once). Separate from the read pool.
RUN_LOCK_POOL_SIZE=10

# Opt-in live model tests (npm run server:test). Sends the golden prompts to the real model.
# Costs real tokens. Leave unset for normal runs.
# LIVE_MODEL_TESTS=1

# Only for API keys not scoped to a workspace (the Console shows the workspace ID).
# ANTHROPIC_WORKSPACE_ID=
